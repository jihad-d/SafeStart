# Supabase > Settings > API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Aucune clé IA : SafeBot est suspendu.
# Ne mets jamais de clé secrète derrière le préfixe VITE_ : elle serait publique.

# Facultatif : clé CoinGecko "demo", utilisée seulement en secours si la
# fonction Supabase market-prices n'est pas déployée.
# Préférer le secret COINGECKO_API_KEY dans Supabase > Edge Functions > Secrets.
# VITE_COINGECKO_API_KEY=
