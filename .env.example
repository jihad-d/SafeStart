# ─── Côté navigateur (préfixe VITE_ = public, inclus dans le bundle) ───
# Supabase > Settings > API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─── Côté serveur uniquement (fonction /api/safebot) ───
# NE JAMAIS préfixer ces variables par VITE_ : elles seraient exposées publiquement.
# Sur Vercel : Project > Settings > Environment Variables
ANTHROPIC_API_KEY=
# Supabase > Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel : par défaut, VITE_SUPABASE_URL est utilisée
# SUPABASE_URL=https://xxxx.supabase.co
